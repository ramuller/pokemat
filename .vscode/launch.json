{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run foo_ocr.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/pokemat/foo_ocr.py",
      "console": "integratedTerminal",
      "args": [
        "--port",
        "3007"
      ]
    },    {
      "name": "Run learning phone",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/pokemat/learn_phone.py",
      "console": "integratedTerminal",
      "preLaunchTask": "prune-phone-dbs",
      "args": [
        "--port",
        "3009"
      ]
    },
    {
      "name": "Run route",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/pokemat/route.py",
      "console": "integratedTerminal",
      "args": [
        "--port",
        "3002"
      ]
    },  
    {
      "name": "Get Icon",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/icons/get_icon.py",
      "cwd": "${workspaceFolder}/icons",      
      "console": "integratedTerminal",

      "args": [
        "--port",
        "3009"
      ]
    },  
    {
      "name": "Run test-ocr",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/testing/test-ocr.py",
      "console": "integratedTerminal",
      "args": [
        "--port",
        "3007"
      ]
    },    {
      "name": "Change trainer",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/pokemat/change_trainer.py",
      "console": "integratedTerminal",
      "args": [
        "--port",
        "3007",
        "schlumpiz
      ]
    }

  ]
}
