{
  "version": "0.2.0",

  "configurations": [
    {
      "name": "poketool read",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/pokemat/poketool.py",
      "console": "integratedTerminal",
      "args": [
        "read",
        "--port",
        "3007",
        "--xe",
        "10%",
        "--show",
        "--invert",
        "--press"
      ],
      "comment":[
        "--process",
        "--name",
        "foo.png",
      ]
    },
    {
      "name": "poketool button",
      "type": "python",
      "request": "launch",
